# ШТОФЪ Екатерининскiй — конфигурация для виртуального хостинга Timeweb.
# Файл лежит в корне сайта (public_html) и подхватывается Apache автоматически.

RewriteEngine On

# --- 1. HTTPS --------------------------------------------------------------
# Редирект http → https включён ТУМБЛЕРОМ в панели Timeweb
# («Настройки сайта → Перенаправлять на HTTPS»), здесь дублировать не нужно.
# Если тумблер вдруг выключится — раскомментировать три строки ниже.
#
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# --- 2. www → без www ------------------------------------------------------
# Канонический адрес — https://shtofekb.ru, он же в canonical и og:url.
# Сразу на https: иначе выходит лишний прыжок www → http → https.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# --- 3. Служебные файлы наружу не отдаём -----------------------------------
RewriteRule (^|/)\.git - [F,L]
RewriteRule ^_.*\.(py|md)$ - [F,L]

# --- 4. Заголовки безопасности ---------------------------------------------
<IfModule mod_headers.c>
  # Браузер обязан ходить только по https. 180 дней.
  # ВАЖНО: если SSL когда-нибудь отвалится, вернувшиеся гости не смогут
  # открыть сайт даже по http — лечится починкой SSL, а не удалением строки.
  Header always set Strict-Transport-Security "max-age=15552000"

  # Не угадывать тип файла по содержимому (защита от подмены картинки скриптом).
  Header always set X-Content-Type-Options "nosniff"

  # Сайт нельзя вставить в чужой iframe — защита от кликджекинга,
  # когда поверх страницы кладут невидимый слой и воруют клики.
  Header always set X-Frame-Options "DENY"

  # При переходе на чужой сайт не передавать полный адрес страницы.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Отключаем то, чем сайт не пользуется.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Откуда странице разрешено что-либо грузить. Всё своё плюс Яндекс.Метрика.
  # 'unsafe-inline' нужен: стили и скрипты у нас встроены в страницу.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://mc.yandex.ru; font-src 'self'; media-src 'self'; connect-src 'self' https://mc.yandex.ru; frame-src https://mc.yandex.ru; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# --- 5. Кэширование статики ------------------------------------------------
# Картинки, шрифты и видео не меняются — отдаём с длинным кэшем.
# HTML не кэшируем, чтобы правки были видны сразу.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp    "access plus 1 year"
  ExpiresByType image/jpeg    "access plus 1 year"
  ExpiresByType image/png     "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2    "access plus 1 year"
  ExpiresByType video/mp4     "access plus 1 year"
  ExpiresByType text/html     "access plus 0 seconds"
</IfModule>

# --- 6. Сжатие -------------------------------------------------------------
# webp/woff2/mp4 уже сжаты — их не трогаем.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript image/svg+xml
</IfModule>

# --- 7. Кодировка ----------------------------------------------------------
AddDefaultCharset UTF-8
